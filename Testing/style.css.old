* { margin: 0; padding: 0; box-sizing: border-box; }

body {
    font-family: 'Poppins', sans-serif;
    background-color: #f0f4f8;
    color: #2c3e50;
    line-height: 1.6;
    padding-bottom: 40px;
}

header {
    background: linear-gradient(135deg, #003580 0%, #0056b3 100%);
    color: white;
    padding: 30px 20px 80px 20px;
    text-align: center;
}

.hero-container { max-width: 500px; margin: 0 auto 15px auto; }
.hero-img { width: 100%; height: auto; border-radius: 20px; border: 4px solid rgba(255, 255, 255, 0.2); box-shadow: 0 10px 30px rgba(0,0,0,0.3); }

header h1 { font-size: 1.8rem; margin-bottom: 5px; }

.countdown-wrap {
    max-width: 400px;
    margin: -50px auto 20px auto;
    padding: 0 20px;
    position: relative;
    z-index: 10;
}

.countdown-card {
    background: white;
    padding: 20px;
    border-radius: 20px;
    text-align: center;
    box-shadow: 0 15px 35px rgba(0,0,0,0.1);
}

#timer { display: flex; justify-content: space-around; }
.time-num { display: block; font-size: 2rem; font-weight: 700; color: #e67e22; }
.label { font-size: 0.6rem; color: #95a5a6; text-transform: uppercase; }

/* FIXED SYDNEY CARD */
.time-card {
    background: #1a2b3c;
    color: #ffffff;
    padding: 20px;
    border-radius: 15px;
    margin-bottom: 20px;
    text-align: center; /* Center-aligned content */
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

#sydney-time { font-size: 1.8rem; color: #f1c40f; margin: 5px 0; }
.location-label { font-size: 0.7rem; text-transform: uppercase; color: #bdc3c7; }

.container { width: 92%; max-width: 600px; margin: 0 auto; }
.card { background: white; padding: 20px; border-radius: 15px; margin-bottom: 20px; }

h2 { font-size: 1.1rem; color: #003580; margin-bottom: 15px; border-left: 4px solid #e67e22; padding-left: 10px; }

.btn-stack { display: flex; flex-direction: column; gap: 10px; }
.btn { text-decoration: none; padding: 14px; border-radius: 12px; text-align: center; font-weight: 600; background: #f8f9fa; color: #0056b3; border: 1px solid #dee2e6; }
.btn.primary { background: #003580; color: white; border: none; }

details { background: #fdfdfd; border: 1px solid #edf2f7; border-radius: 10px; margin-bottom: 10px; overflow: hidden; }
summary { padding: 15px; cursor: pointer; display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; list-style: none; }
summary::after { content: '＋'; color: #e67e22; }
details[open] summary::after { content: '－'; }
.details-content { padding: 0 15px 15px 15px; font-size: 0.85rem; border-top: 1px solid #f7fafc; }

.info-links a { color: #0056b3; text-decoration: none; font-weight: 600; background: #f0f7ff; padding: 10px; border-radius: 8px; text-align: center; display: block; margin-top: 10px; }

footer { text-align: center; color: #95a5a6; font-size: 0.75rem; padding-top: 10px; }